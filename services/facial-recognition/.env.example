# ============================================================
# BSU Personnel Monitoring – Environment Configuration
# ============================================================
# 1. Copy this file to .env  (same folder as the .py script)
# 2. Fill in your real values
# 3. NEVER commit .env to git – add it to .gitignore
# ============================================================

# ── Web API ─────────────────────────────────────────────────
API_URL=https://YOUR_APP.replit.app
API_KEY=your-facial-recognition-api-key

# ── Camera 1 ────────────────────────────────────────────────
CAM1_NAME=Camera 1
CAM1_IP=192.168.x.x
CAM1_USER=admin
CAM1_PASS=your-camera-password
CAM1_PORT=554
# /101 = main stream (best quality – matches the browser Live View).
# /102 = sub-stream (lower quality, fallback if /101 is too heavy).
# IMPORTANT: If using /101, set the camera's main-stream resolution to 1080p
# in the camera web UI (Configuration → Video → Main Stream → 1920×1080).
# Leaving the main stream at 4K will cause h264 decoding errors.
CAM1_STREAM_PATH=/Streaming/Channels/101

# ── Camera 2 ────────────────────────────────────────────────
CAM2_NAME=Camera 2
CAM2_IP=192.168.1.65
CAM2_USER=admin
CAM2_PASS=bbffu@274
CAM2_PORT=554
CAM2_STREAM_PATH=/Streaming/Channels/101

# ── Camera 3 (optional – add as many as needed) ─────────────
# CAM3_NAME=Camera 3
# CAM3_IP=192.168.1.66
# CAM3_USER=admin
# CAM3_PASS=your_password_here
# CAM3_PORT=554
# CAM3_STREAM_PATH=/Streaming/Channels/101

# ── Notes ────────────────────────────────────────────────────
# To use on campus (different subnet), just change the IP values above.
# No code changes are required when you move networks.
# For cameras with custom RTSP URLs, you can override:
#   CAM1_STREAM_URL=rtsp://admin:pass@ip:port/custom/path
